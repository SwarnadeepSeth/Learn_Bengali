{
  "id": "lesson27-postpositions",
  "title": "Postpositions",
  "category": "intermediate",
  "description": "Master Bengali postpositions: location (-তে), direction (-এর দিকে), source (-থেকে), association (-সাথে/-দিয়ে), time (-এ/-পর), possession (-এর)",
  "type": "grammar_learning",
  "total_items": 30,
  "estimated_time": "35 minutes",
  "grammar_rules": [
    {
      "rule_title": "Location Postpositions (-তে, -এ)",
      "rule_explanation": "Location postpositions indicate 'in', 'at', or 'on' a place. -তে (-te) is used for most locations, -এ (-e) for some specific contexts.",
      "key_points": [
        "-তে (-te): general location (in, at, on)",
        "-এ (-e): used in some place names",
        "No distinction between 'in' and 'on'",
        "Used with verbs of location and position"
      ]
    },
    {
      "rule_title": "Direction Postpositions (-এর দিকে)",
      "rule_explanation": "Direction postpositions show movement toward using -এর দিকে (-er dike), meaning 'toward' or 'in the direction of'.",
      "key_points": [
        "-এর দিকে (-er dike): toward, in the direction of",
        "Used for movement toward a destination",
        "Genitive + দিকে structure",
        "Can be used metaphorically"
      ]
    },
    {
      "rule_title": "Source Postpositions (-থেকে)",
      "rule_explanation": "Source postpositions indicate origin or starting point using -থেকে (-theke), meaning 'from' or 'since'.",
      "key_points": [
        "-থেকে (-theke): from, since, starting from",
        "Used for origin, source, and time duration",
        "Opposite of direction postpositions",
        "Works with places, times, and sources"
      ]
    },
    {
      "rule_title": "Association Postpositions (-সাথে, -দিয়ে)",
      "rule_explanation": "Association postpositions show accompaniment or means. -সাথে (-sathe) means 'with' (accompaniment), -দিয়ে (-diye) means 'with' (instrument).",
      "key_points": [
        "-সাথে (-sathe): with (accompaniment)",
        "-দিয়ে (-diye): with/by (instrument/means)",
        "Different meanings for similar English words",
        "Used for people, tools, and methods"
      ]
    },
    {
      "rule_title": "Time Postpositions (-এ, -থেকে, -পর)",
      "rule_explanation": "Time postpositions express temporal relationships: -এ (-e) for 'at', -থেকে (-theke) for 'since', -পর (-por) for 'after'.",
      "key_points": [
        "-এ (-e): at, in, on (specific times)",
        "-থেকে (-theke): since, from (duration)",
        "-পর (-por): after",
        "-আগে (-age): before"
      ]
    },
    {
      "rule_title": "Possession Postpositions (-এর)",
      "rule_explanation": "The postposition -এর (-er) shows possession and relationships, attached to the possessor before the possessed noun.",
      "key_points": [
        "-এর (-er): of, 's (possession)",
        "Used after vowels",
        "Shows ownership, relationship, attribution",
        "Possessor always comes first"
      ]
    }
  ],
