{
  "id": "lesson16-verb-conjugations",
  "title": "Verb Conjugations",
  "category": "intermediate",
  "description": "Master Bengali verb conjugations: present (-ই/-ও/-য়), past (-লাম/-লে/-ল), and future (হবে + verb)",
  "type": "grammar_learning",
  "total_items": 30,
  "estimated_time": "30 minutes",
  "grammar_rules": [
    {
      "rule_title": "Present Tense Conjugation",
      "rule_explanation": "Present tense verbs change endings based on person and number. The verb root stays the same, but different suffixes are added according to the subject.",
      "key_points": [
        "First person singular/plural: -ই (-i)",
        "Second person informal: -ও (-o)",
        "Second person formal/plural: -েন (-en)",
        "Third person: -য় (-y)",
        "Honorific third person: -েন (-en)"
      ]
    },
    {
      "rule_title": "Past Tense Conjugation",
      "rule_explanation": "Past tense uses -ল (-l) endings. First person uses -লাম (-lam), second person informal uses -লে (-le), third person uses -ল (-l).",
      "key_points": [
        "First person singular: -লাম (-lam)",
        "Second person informal: -লে (-le)",
        "Third person: -ল (-l)",
        "Formal/respectful: -লেন (-len)",
        "Perfect past uses হয়েছে + past participle"
      ]
    },
    {
      "rule_title": "Future Tense Conjugation",
      "rule_explanation": "Future tense uses হবে (hobe) + verb root. The verb root remains unchanged, and person is indicated by the subject, not verb endings.",
      "key_points": [
        "Future marker: হবে (hobe)",
        "Verb root stays unchanged",
        "Person indicated by subject",
        "Formal future: হবেন (hoben)",
        "Negative: হবে না (hobe na)"
      ]
    }
  ],
