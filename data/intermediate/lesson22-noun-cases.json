{
  "id": "lesson22-noun-cases",
  "title": "Noun Cases",
  "category": "intermediate",
  "description": "Master Bengali noun cases: nominative (subject), accusative (object), genitive (possession), locative (location/time)",
  "type": "grammar_learning",
  "total_items": 30,
  "estimated_time": "30 minutes",
  "grammar_rules": [
    {
      "rule_title": "Nominative Case (Subject)",
      "rule_explanation": "The nominative case marks the subject of a sentence. Subjects usually have no case marker, though definite articles -টা/-টি can be used for emphasis.",
      "key_points": [
        "No case marker needed for subjects",
        "Definite articles -টা (masculine) and -টি (feminine) can be added",
        "Subject comes before the verb",
        "Can be omitted in certain contexts"
      ]
    },
    {
      "rule_title": "Accusative Case (Direct Object)",
      "rule_explanation": "The accusative case marks direct objects. Use -কে (-ke) for animate objects, -টা/-টি (-ta/-ti) for inanimate objects or no marker.",
      "key_points": [
        "Animate objects: -কে (-ke)",
        "Inanimate objects: -টা/-টি (-ta/-ti) or unmarked",
        "-কে is mandatory for animate direct objects",
        "Case markers help distinguish subject from object"
      ]
    },
    {
      "rule_title": "Genitive Case (Possession)",
      "rule_explanation": "The genitive case shows possession using -র (-r) after consonants and -এর (-er) after vowels. The possessor comes first.",
      "key_points": [
        "After consonants: -র (-r)",
        "After vowels: -এর (-er)",
        "Possessor comes before possessed",
        "Used for ownership and relationships"
      ]
    },
    {
      "rule_title": "Locative Case (Location/Time)",
      "rule_explanation": "The locative case uses -তে (-te) for location and time. It indicates 'in', 'at', or 'on' a place or time.",
      "key_points": [
        "Location: -তে (-te)",
        "Time: -তে (-te)",
        "Used with verbs of location and time",
        "No distinction between 'in' and 'on' like English"
      ]
    }
  ],
