{
  "id": "lesson11-basic-sentence-structure",
  "title": "Basic Sentence Structure",
  "category": "intermediate",
  "description": "Learn the fundamental rules of Bengali sentence structure: Subject-Object-Verb order, present tense verbs, and question formation",
  "type": "grammar_learning",
  "total_items": 30,
  "estimated_time": "25 minutes",
  "grammar_rules": [
    {
      "rule_title": "Subject-Object-Verb Order",
      "rule_explanation": "Bengali follows Subject + Object + Verb word order, which is different from English. The subject comes first, then the object, and finally the verb. Case markers help distinguish grammatical roles. This is a key feature that makes Bengali unique.",
      "key_points": [
        "Subject comes before the object",
        "Verb comes AFTER the object (not before)",
        "Case markers clarify roles (nominative, accusative, locative)",
        "Word order can be flexible for emphasis, but SOV is standard",
        "This order is typical of many Asian languages"
      ]
    },
    {
      "rule_title": "Present Tense Verbs",
      "rule_explanation": "Present tense verbs change endings based on person and number. First person uses -ই (-i) or -ি (-i), second person informal uses -ও (-o), third person uses -ে (-e) or -য় (-y).",
      "key_points": [
        "First person singular/plural: -ই (-i) or -ি (-i)",
        "Second person informal: -ও (-o)",
        "Third person: -ে (-e) or -য় (-y)",
        "Honorific forms exist for respect (আপনি uses -েন, -ন)"
      ]
    },
    {
      "rule_title": "Question Formation",
      "rule_explanation": "Questions use কি (ki) after the subject for yes/no questions. Wh-questions place the question word at the beginning, maintaining SOV order. Rising intonation can also indicate questions.",
      "key_points": [
        "কি (ki) makes yes/no questions after subject",
        "Question words (কে, কোথায়, কখন, কী) come first",
        "Subject-Object-Verb order maintained",
        "Rising intonation emphasizes questions"
      ]
    }
  ],
