{
  "id": "lesson11-basic-sentence-structure",
  "title": "Basic Sentence Structure",
  "category": "intermediate",
  "description": "Learn the fundamental rules of Bengali sentence structure: Subject-Verb-Object order, present tense verbs, and question formation",
  "type": "grammar_learning",
  "total_items": 30,
  "estimated_time": "25 minutes",
  "grammar_rules": [
    {
      "rule_title": "Subject-Verb-Object Order",
      "rule_explanation": "Bengali follows Subject + Verb + Object word order, similar to English. The subject comes first, followed by the verb, then the object. Case markers help distinguish grammatical roles.",
      "key_points": [
        "Subject comes before the verb",
        "Verb comes before the object",
        "Word order can be flexible for emphasis",
        "Case markers clarify roles when needed"
      ]
    },
    {
      "rule_title": "Present Tense Verbs",
      "rule_explanation": "Present tense verbs change endings based on person and number. First person uses -ই (-i), second person informal uses -ও (-o), third person uses -য় (-y).",
      "key_points": [
        "First person singular/plural: -ই (-i)",
        "Second person informal: -ও (-o)",
        "Third person: -য় (-y)",
        "Honorific forms exist for respect"
      ]
    },
    {
      "rule_title": "Question Formation",
      "rule_explanation": "Questions use কি (ki) after the subject for yes/no questions. Wh-questions place the question word at the beginning. Rising intonation can also indicate questions.",
      "key_points": [
        "কি (ki) makes yes/no questions",
        "Question words come first",
        "Subject-Verb-Object order maintained",
        "Rising intonation indicates questions"
      ]
    }
  ],
